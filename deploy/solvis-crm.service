[Unit]
Description=Solvis CRM - back general (Django API)
After=network.target postgresql.service

[Service]
User=solvcrm
Group=solvcrm
WorkingDirectory=/opt/solvis-crm
EnvironmentFile=/etc/solvis-crm.env
ExecStart=/opt/solvis-crm/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8002 --access-logfile - config.wsgi:application
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
